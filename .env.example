# Copy to .env (next to compose.yaml) and fill in. .env is ignored by git; keep it that way.

# The name people will type. Point its DNS A (and AAAA) record at your server first.
COMPOSER_DOMAIN=brief.example.com

# Your email address for automatic public certificates, or `internal` for a trial on your own machine.
COMPOSER_TLS=you@example.com

# The login. Make the hash with: docker compose run --rm --no-deps caddy caddy hash-password
# Keep the single quotes: the hash contains $ signs.
COMPOSER_LOGIN_USER=me
COMPOSER_LOGIN_HASH='paste the hash here'

# Optional.
# COMPOSER_VERSION=0.2.0
# COMPOSER_HTTP_PORT=80
# COMPOSER_HTTPS_PORT=443
# COMPOSER_FRONT_SUBNET=172.30.65.0/24
